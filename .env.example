# Copy to .env (gitignored) and fill in ONE provider. With nothing set, every
# project runs offline against a deterministic mock chat model.

# Force a provider: mock | azure | openai  (optional; auto-detected otherwise)
# LLM_PROVIDER=mock

# --- Azure OpenAI ---
# Keyless by default: DefaultAzureCredential (managed identity in Azure, `az login` locally)
# needs the "Cognitive Services OpenAI User" role on the resource. Set the key only if you must.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Azure AI Content Safety Prompt Shields (optional; off by default) ---
# With both set, untrusted context and tool payloads are also screened by Prompt Shields after the
# regex sanitizer (keyless; the identity needs "Cognitive Services User" on the resource).
# PROMPT_SHIELDS=1
# AZURE_CONTENT_SAFETY_ENDPOINT=https://<resource>.cognitiveservices.azure.com/

# --- OpenAI ---
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini

# --- IT desk agent on Amazon Bedrock (aws-it-desk-agent/) ---
# Leave unset for the deterministic mock. Live calls need `uv sync --extra aws` and model access.
# IT_DESK_PROVIDER=bedrock
# BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
# AWS_REGION=us-east-1
# IT_DESK_LOG_MODE=cloudwatch
# IT_DESK_LOG_GROUP=/it-desk/playbook

# --- Assessment bank (assessment-bank/) ---
# Local default is mock auth and an in-memory store. The deployed container sets entra + cosmos.
# ASSESSMENT_AUTH_MODE=mock
# ASSESSMENT_STORE=memory
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_TENANT_SUBDOMAIN=assessmentbank
# COSMOS_ENDPOINT=
# COSMOS_DATABASE=assessments
# COSMOS_CONTAINER=progress
