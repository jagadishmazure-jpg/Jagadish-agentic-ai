# Copy to .env (gitignored) and fill in ONE provider. With nothing set, every
# project runs offline against a deterministic mock chat model.

# Force a provider: mock | azure | openai  (optional; auto-detected otherwise)
# LLM_PROVIDER=mock

# --- Azure OpenAI ---
# Keyless by default: DefaultAzureCredential (managed identity in Azure, `az login` locally)
# needs the "Cognitive Services OpenAI User" role on the resource. Set the key only if you must.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Azure AI Content Safety Prompt Shields (optional; off by default) ---
# With both set, untrusted context and tool payloads are also screened by Prompt Shields after the
# regex sanitizer (keyless; the identity needs "Cognitive Services User" on the resource).
# PROMPT_SHIELDS=1
# AZURE_CONTENT_SAFETY_ENDPOINT=https://<resource>.cognitiveservices.azure.com/

# --- OpenAI ---
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini
