# Copy to .env (gitignored) and fill in ONE provider. With nothing set, every
# project runs offline against a deterministic mock chat model.

# Force a provider: mock | azure | openai  (optional; auto-detected otherwise)
# LLM_PROVIDER=mock

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# --- OpenAI ---
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini
