config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	intake(intake)
	eligibility(eligibility)
	policy(policy)
	criteria(criteria)
	draft_packet(draft_packet)
	clinician_approval(clinician_approval)
	submit(submit)
	member_reply(member_reply)
	__end__([<p>__end__</p>]):::last
	__start__ --> intake;
	clinician_approval --> submit;
	coverage_language\3acite_check --> draft_packet;
	criteria -.-> __end__;
	criteria -.-> coverage_language\3adraft;
	draft_packet -.-> __end__;
	draft_packet -.-> clinician_approval;
	eligibility --> criteria;
	intake -.-> eligibility;
	intake -.-> member_reply;
	intake -.-> policy;
	policy --> criteria;
	member_reply --> __end__;
	submit --> __end__;
	subgraph coverage_language
	coverage_language\3adraft(draft)
	coverage_language\3acite_check(cite_check)
	coverage_language\3adraft --> coverage_language\3acite_check;
	end
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
