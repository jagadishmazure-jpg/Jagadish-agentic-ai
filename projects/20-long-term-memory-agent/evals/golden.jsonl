{"id": "recall-name-across-sessions", "input": {"script": [{"user": "u1", "thread": "s1", "say": "Hi, my name is Priya."}], "ask": {"user": "u1", "thread": "s2", "say": "What's my name?", "advance_days": 3}}, "expect": {"contains": ["Priya"], "stored": {"u1": {"name_to_use": "Priya"}}}}
