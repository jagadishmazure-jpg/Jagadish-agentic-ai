config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	researcher(researcher)
	analyst(analyst)
	policy(policy)
	drafter(drafter)
	reviewer(reviewer)
	finish(finish)
	__end__([<p>__end__</p>]):::last
	__start__ --> researcher;
	analyst -.-> drafter;
	analyst -.-> finish;
	analyst -.-> policy;
	analyst -.-> researcher;
	analyst -.-> reviewer;
	drafter -.-> analyst;
	drafter -.-> finish;
	drafter -.-> policy;
	drafter -.-> researcher;
	drafter -.-> reviewer;
	policy -.-> analyst;
	policy -.-> drafter;
	policy -.-> finish;
	policy -.-> researcher;
	policy -.-> reviewer;
	researcher -.-> analyst;
	researcher -.-> drafter;
	researcher -.-> finish;
	researcher -.-> policy;
	researcher -.-> reviewer;
	reviewer -.-> analyst;
	reviewer -.-> drafter;
	reviewer -.-> finish;
	reviewer -.-> policy;
	reviewer -.-> researcher;
	finish --> __end__;
	analyst -.-> analyst;
	drafter -.-> drafter;
	policy -.-> policy;
	researcher -.-> researcher;
	reviewer -.-> reviewer;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
